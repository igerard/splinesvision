Cell[CellGroupData[{

Cell["Reduce the images size for the demo", "Section",
 CellChangeTimes->{{3.747460158227813*^9, 
  3.747460169227441*^9}},ExpressionUUID->"e202f599-393b-4ed1-a0fc-\
ffdba9cfbe15"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "function", " ", "to", " ", "resize", " ", "image", " ", "of", " ", "a", " ",
     "given", " ", "label"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"ClearAll", "[", "labelDataRR", "]"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{
    "This", " ", "is", " ", "clearing", " ", "all", " ", "memorized", " ", 
     "values"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"labelDataRR", "[", "label_", "]"}], " ", ":=", " ", 
    RowBox[{
     RowBox[{"labelDataRR", "[", "label", "]"}], " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"ImageData", "[", 
        RowBox[{
         RowBox[{"ImageResize", "[", 
          RowBox[{
           RowBox[{"Image", "[", 
