Cell[CellGroupData[{

Cell["Classifier function", "Section",
 CellChangeTimes->{{3.7476459073202353`*^9, 
  3.747645913880575*^9}},ExpressionUUID->"2f2f1491-a91d-43fe-91f6-\
f5a7148100a8"],

Cell["\<\
All the labels have same probability, then we want to compute : \
\>", "Text",
 CellChangeTimes->{{3.747646753073092*^9, 
  3.747646795061078*^9}},ExpressionUUID->"9cd138f2-07a8-40ca-b5aa-\
c27f543c1b03"],

Cell[BoxData[
 FormBox[
  RowBox[{
   StyleBox["\[LineSeparator]",
    FontSize->24], 
   RowBox[{
    StyleBox[
     RowBox[{
      RowBox[{"P", "(", 
       RowBox[{
        RowBox[{
         SubscriptBox["C", "k"], "|", 
         SubscriptBox["x", "1"]}], ",", 
        SubscriptBox["x", "2"], ",", "\[Ellipsis]", ",", 
        SubscriptBox["x", "n"]}], ")"}], "=", 
      RowBox[{
       RowBox[{"P", "[", 
        RowBox[{
         SubscriptBox["x", "1"], "|", 
         SubscriptBox["C", "k"]}], "]"}], 
       RowBox[{"P", "[", 
        RowBox[{
         SubscriptBox["x", "2"], "|", 
         SubscriptBox["C", "k"]}], "]"}], 
       RowBox[{"\[Ellipsis]P", "[", 
        RowBox[{
         SubscriptBox["x", "n"], "|", 
         SubscriptBox["C", "k"]}], "]"}]}]}],
     FontSize->24], 
    StyleBox["\[IndentingNewLine]",
     FontSize->24], "\[IndentingNewLine]", 
    StyleBox[
     RowBox[{
      RowBox[{
       RowBox[{"Underflow", " ", "possible"}], " ", "..."}], " ", "we", " ", 
      "move", " ", "in", " ", "Logarithm", " ", "space", " ", "and", " ", 
      "will", " ", "end", " ", "to", " ", "compare", " ", "log", " ", "of", " ",
       "probability"}],
     FontSize->18,
     FontSlant->"Italic"], "\[IndentingNewLine]", "\[LineSeparator]", "\[IndentingNewLine]", 
    StyleBox[
     RowBox[{
      RowBox[{"Log", "(", 
       RowBox[{"x", " ", "+", " ", "y"}], ")"}], " ", "=", " ", 
      RowBox[{
       RowBox[{"Log", "(", "x", ")"}], " ", "+", " ", 
       RowBox[{"Log", "(", "y", ")"}]}]}],
     FontSize->24], "\[IndentingNewLine]", "\[LineSeparator]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      StyleBox["Log",
       FontSize->24], 
      StyleBox["[",
       FontSize->24], 
      RowBox[{"P", "(", 
       RowBox[{
        RowBox[{
         SubscriptBox["C", "k"], "|", 
         SubscriptBox["x", "1"]}], ",", 
        SubscriptBox["x", "2"], ",", "\[Ellipsis]", ",", 
        SubscriptBox["x", "n"]}], ")"}], "]"}], " ", "=", " ", 
     RowBox[{
      RowBox[{"Log", "[", 
       RowBox[{"P", "[", 
        RowBox[{
         SubscriptBox["x", "2"], "|", 
         SubscriptBox["C", "k"]}], "]"}], "]"}], " ", "+", " ", "\[Ellipsis]",
       " ", "+", " ", 
      RowBox[{"Log", "[", 
       RowBox[{"P", "[", 
        RowBox[{
         SubscriptBox["x", "n"], "|", 
         SubscriptBox["C", "k"]}], "]"}], "]"}]}]}]}]}], 
  TraditionalForm]], "Text",
 CellChangeTimes->{{3.747646809329986*^9, 3.7476468148276443`*^9}, {
  3.7476538601247787`*^9, 3.747653952052205*^9}, {3.747850787884014*^9, 
  3.747850881962682*^9}, {3.747850923017363*^9, 3.747850925211793*^9}, {
