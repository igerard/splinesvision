Cell[BoxData[
 FormBox[
  StyleBox[
   RowBox[{
    RowBox[{"P", "(", 
     RowBox[{
      RowBox[{
       SubscriptBox["C", "k"], "|", 
       SubscriptBox["x", "1"]}], ",", 
      SubscriptBox["x", "2"], ",", "\[Ellipsis]", ",", 
      SubscriptBox["x", "n"]}], ")"}], "=", 
    FractionBox[
     RowBox[{
      RowBox[{"P", "[", 
       RowBox[{
        SubscriptBox["x", "1"], "|", 
        SubscriptBox["C", "k"]}], "]"}], 
      RowBox[{"P", "[", 
       RowBox[{
        SubscriptBox["x", "2"], "|", 
        SubscriptBox["C", "k"]}], "]"}], 
      RowBox[{"\[Ellipsis]P", "[", 
       RowBox[{
        SubscriptBox["x", "n"], "|", 
        SubscriptBox["C", "k"]}], "]"}], 
      RowBox[{"P", "(", 
       SubscriptBox["C", "k"], ")"}]}], 
     RowBox[{"P", "(", 
      RowBox[{
       SubscriptBox["x", "1"], ",", 
       SubscriptBox["x", "2"], ",", "\[Ellipsis]", ",", 
       SubscriptBox["x", "n"]}], ")"}]]}],
   FontSize->24], TraditionalForm]], "Text",
