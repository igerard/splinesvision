Cell[CellGroupData[{

Cell["We define the function needed to extract the features", "Section",
 CellChangeTimes->{{3.7474777605244007`*^9, 
  3.747477774782218*^9}},ExpressionUUID->"bb70d7cc-bd90-428a-b7f2-\
b405885a991e"],

Cell["\<\
Each pixel value or level is a feature value in our classification approach
We define the function to extract the values of a pixel, which give the \
feature values histogram
Then the function that create the matrix of the features values \
\>", "Text",
 CellChangeTimes->{{3.74747778032242*^9, 3.747477781187147*^9}, {
  3.747477955331542*^9, 3.7474780133971157`*^9}, {3.7474781278732977`*^9, 
  3.747478183665285*^9}, {3.747478227532173*^9, 3.7474782440719013`*^9}, {
  3.747549850949078*^9, 3.747549896423448*^9}, {3.7476438514542294`*^9, 
  3.7476438519080887`*^9}, {3.7478247431338377`*^9, 3.7478247802246027`*^9}, {
  3.747825777514647*^9, 
  3.7478258151397953`*^9}},ExpressionUUID->"64d75586-f2cd-49c0-bf39-\
77cfe203dc05"],

Cell[BoxData[{
 RowBox[{"ClearAll", "[", "FeatureMatrix", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"featureValues", "[", 
    RowBox[{"data_", ",", " ", "i_", ",", " ", "j_"}], "]"}], " ", ":=", " ", 
   
   RowBox[{"data", "[", 
    RowBox[{"[", 
     RowBox[{
      RowBox[{"Range", "[", 
       RowBox[{"Length", "[", "data", "]"}], "]"}], ",", "i", ",", "j"}], 
     "]"}], "]"}]}], "  ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
     "all", " ", "the", " ", "values", " ", "for", " ", "one", " ", 
      "specific", " ", "pixel"}], " ", "..."}], " ", "for", " ", "the", " ", 
    "all", " ", "the", " ", "images"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"FeatureMatrix", "[", "data_", "]"}], " ", ":=", " ", 
  RowBox[{
   RowBox[{"FeatureMatrix", "[", "data", "]"}], " ", "=", " ", 
   RowBox[{"Array", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"featureValues", "[", 
       RowBox[{"data", ",", " ", "##"}], "]"}], "&"}], ",", " ", 
     RowBox[{"Drop", "[", 
      RowBox[{
       RowBox[{"Dimensions", "[", "data", "]"}], ",", "1"}], "]"}]}], "]"}], 
   "    ", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"The", " ", "matrix", " ", "of", " ", "the", " ", "features"}], 
     " ", ",", " ", 
     RowBox[{
     "change", " ", "the", " ", "way", " ", "to", " ", "see", " ", "the", " ",
       "list", " ", "of", " ", "images"}]}], " ", "*)"}]}]}]}], "Input",
 CellChangeTimes->{{3.745784619722673*^9, 3.7457846206017523`*^9}, {
  3.747478141677435*^9, 3.747478148138363*^9}, {3.7475499353336277`*^9, 
  3.747550021359723*^9}, {3.7476287001395082`*^9, 3.747628702943199*^9}, {
  3.747631384241539*^9, 3.7476313892809153`*^9}},
 CellLabel->"In[53]:=",ExpressionUUID->"ae5f36e1-dfae-42b8-8fa1-6ecc6e12029b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
We check that the matrix of the means of the features values is the same as \
the mean of the images\
\>", "Section",
 CellChangeTimes->{{3.747478251188878*^9, 
  3.747478298780171*^9}},ExpressionUUID->"ccc452ca-fd19-4b01-98cd-\
719aef37c16a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ll", " ", "=", " ", "5"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Array", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Mean", "[", 
      RowBox[{
       RowBox[{"FeatureMatrix", "[", 
        RowBox[{"labelDataRR", "[", "ll", "]"}], "]"}], "[", 
       RowBox[{"[", "##", "]"}], "]"}], "]"}], "&"}], ",", " ", 
    RowBox[{"Drop", "[", 
     RowBox[{
      RowBox[{"Dimensions", "[", 
       RowBox[{"FeatureMatrix", "[", 
        RowBox[{"labelDataRR", "[", "ll", "]"}], "]"}], "]"}], ",", " ", 
      RowBox[{"-", "1"}]}], "]"}]}], "]"}], " ", "//", " ", 
  "MatrixPlot"}]}], "Input",
