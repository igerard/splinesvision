Cell[CellGroupData[{

Cell["\<\
We apply it for all the test data and for all the label
To get the success rate of the classification\
\>", "Subtitle",
 CellChangeTimes->{{3.747883769866027*^9, 3.747883779966354*^9}, {
  3.747884625037174*^9, 3.747884668745215*^9}, {3.747885463130486*^9, 
  3.747885508144721*^9}},ExpressionUUID->"3a401347-bd15-49b7-920c-\
68fbd5ef9759"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "The", " ", "simple", " ", "function", " ", "which", " ", "do", " ", "the",
     " ", "calculus", " ", "for", " ", "a", " ", "given", " ", "label"}], " ",
    "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"TestDataSet", "[", "label_", "]"}], " ", ":=", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Parallelize", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Array", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"logClassProbM", "[", 
              RowBox[{
               RowBox[{"#", "-", "1"}], ",", " ", 
               RowBox[{
                RowBox[{"labelDataTR", "[", "label", "]"}], "[", 
                RowBox[{"[", "i", "]"}], "]"}]}], "]"}], "&"}], ",", " ", 
            "10"}], "]"}], " ", "//", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"Ordering", "[", 
             RowBox[{"#", ",", " ", 
              RowBox[{"-", "1"}]}], "]"}], "-", "1"}], "&"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", "1", ",", " ", 
           RowBox[{"Length", "[", 
            RowBox[{"labelDataTR", "[", "label", "]"}], "]"}]}], "}"}]}], 
        "]"}], "]"}], "//", " ", "Flatten"}], " ", "//", " ", 
     "PositionIndex"}], " ", "//", " ", 
    RowBox[{
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "#", "]"}], "&"}], ",", " ", "#"}], "]"}], 
     "&"}]}]}]}]], "Input",
