Cell[CellGroupData[{

Cell["\<\
SSp = Sp[ordreU,ordreV,knotsU,knotsV,coords];
net = Table[Evaluate[SSp[u,v]],
            {u,0,3,0.1},
            {v,0,2,0.1}];
surf  = Show[{Graphics3D[{Map[Line,net],
                         Map[Line,Transpose[net]]}], PDS},
             ViewPoint->{0.369, -3.156, 1.163},
             PlotRange -> All]\
\>", "Input",
