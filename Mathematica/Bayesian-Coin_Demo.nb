 CellLabel->"In[15]:=",ExpressionUUID->"fedfb384-df50-4b65-a137-92e2af5b08d9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"PosteriorP", "[", " ", 
  RowBox[{
  "\[Theta]", ",", " ", "\[Alpha]", ",", "\[Beta]", ",", " ", "k", ",", " ", 
   "n"}], "]"}]], "Input",
 CellChangeTimes->{{3.747410493793304*^9, 3.747410497477501*^9}, {
  3.747418083892456*^9, 3.7474180898455353`*^9}},
 CellLabel->"In[16]:=",ExpressionUUID->"c8d9f588-4137-4415-a19d-d71b9a0038d8"],

Cell[BoxData[
 TemplateBox[{
   FractionBox[
    RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
         RowBox[{"1", "-", "\[Theta]"}], ")"}], 
       RowBox[{
         RowBox[{"-", "1"}], "-", "k", "+", "n", "+", "\[Beta]"}]], " ", 
      SuperscriptBox["\[Theta]", 
       RowBox[{
         RowBox[{"-", "1"}], "+", "k", "+", "\[Alpha]"}]], " ", 
      RowBox[{"Gamma", "[", 
        RowBox[{"n", "+", "\[Alpha]", "+", "\[Beta]"}], "]"}]}], 
    RowBox[{
      RowBox[{"Gamma", "[", 
        RowBox[{"k", "+", "\[Alpha]"}], "]"}], " ", 
      RowBox[{"Gamma", "[", 
        RowBox[{
          RowBox[{"-", "k"}], "+", "n", "+", "\[Beta]"}], "]"}]}]], 
   RowBox[{
     RowBox[{
       RowBox[{
         RowBox[{"Re", "[", "k", "]"}], "-", 
         RowBox[{"Re", "[", 
           RowBox[{"n", "+", "\[Beta]"}], "]"}]}], "<", "0"}], "&&", 
     RowBox[{
       RowBox[{"Re", "[", "\[Alpha]", "]"}], ">", "0"}], "&&", 
     RowBox[{
       RowBox[{"Re", "[", 
         RowBox[{"k", "+", "\[Alpha]"}], "]"}], ">", "0"}], "&&", 
     RowBox[{
       RowBox[{"Re", "[", "\[Beta]", "]"}], ">", "0"}]}]},
  "ConditionalExpression"]], "Output",
 CellChangeTimes->{3.747410502039734*^9, 3.74741728132555*^9, 
  3.74741798905215*^9, 3.747418094226923*^9, 3.747418477427012*^9, 
  3.747419110730193*^9, 3.7798557700895777`*^9, 3.8169616944290648`*^9, 
  3.989479094838686*^9},
 CellLabel->"Out[16]=",ExpressionUUID->"d133f5d8-02dd-4ff8-823b-815a6c91e903"]
}, Open  ]],

Cell["\<\
Which is equal to the PriorP function with shifted values of \[Alpha] and \
\[Beta], as we recognize the expression of the Beta function and the :\
\>", "Text",
 CellChangeTimes->{{3.747410257554694*^9, 3.747410290988902*^9}, {
  3.747410390382824*^9, 
  3.747410415111721*^9}},ExpressionUUID->"adde8e5c-ae4b-494a-b261-\
5bcb4ce72512"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"PosteriorP", "[", " ", 
   RowBox[{
   "\[Theta]", ",", " ", "\[Alpha]", ",", "\[Beta]", ",", " ", "k", ",", " ", 
    "n"}], "]"}], " ", "\[Equal]", " ", 
  RowBox[{"PriorP", "[", 
   RowBox[{"\[Theta]", ",", " ", 
    RowBox[{"\[Alpha]", "+", "k"}], ",", " ", 
    RowBox[{"\[Beta]", "+", "n", "-", "k"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.747410329183209*^9, 3.747410374471449*^9}, {
  3.7474181205661917`*^9, 3.747418127171073*^9}},
 CellLabel->"In[17]:=",ExpressionUUID->"bcc1ee6a-32ab-464b-95c2-033c0048c796"],

Cell[BoxData[
 TemplateBox[{"True", 
   InterpretationBox[
    DynamicModuleBox[{Typeset`open = False}, 
     TemplateBox[{"Expression", 
       StyleBox[
        TagBox[
         TooltipBox["\"condition\"", 
          TagBox[
           RowBox[{
             RowBox[{
               RowBox[{
                 RowBox[{"Re", "[", "k", "]"}], "-", 
                 RowBox[{"Re", "[", 
                   RowBox[{"n", "+", "\[Beta]"}], "]"}]}], "<", "0"}], "&&", 
             RowBox[{
               RowBox[{"Re", "[", "\[Alpha]", "]"}], ">", "0"}], "&&", 
             RowBox[{
               RowBox[{"Re", "[", 
                 RowBox[{"k", "+", "\[Alpha]"}], "]"}], ">", "0"}], "&&", 
             RowBox[{
               RowBox[{"Re", "[", "\[Beta]", "]"}], ">", "0"}], "&&", 
             RowBox[{
               RowBox[{"Re", "[", 
                 RowBox[{
                   RowBox[{"-", "k"}], "+", "n", "+", "\[Beta]"}], "]"}], ">",
                "0"}]}], Short[#, 7]& ]], Annotation[#, 
          Short[
           And[
           Re[$CellContext`k] - Re[$CellContext`n + $CellContext`\[Beta]] < 0,
             Re[$CellContext`\[Alpha]] > 0, 
            Re[$CellContext`k + $CellContext`\[Alpha]] > 0, 
            Re[$CellContext`\[Beta]] > 0, 
            Re[-$CellContext`k + $CellContext`n + $CellContext`\[Beta]] > 0], 
           7], "Tooltip"]& ], "IconizedCustomName", StripOnInput -> False], 
       GridBox[{{
          RowBox[{
            TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["And", "IconizedItem"]}]}, {
          RowBox[{
            TagBox["\"Byte count: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            
            TagBox["1104", "IconizedItem"]}]}}, 
        GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
        "Column", 
        GridBoxItemSize -> {
         "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
       Dynamic[Typeset`open]}, "IconizedObject"]], 
    And[Re[$CellContext`k] - Re[$CellContext`n + $CellContext`\[Beta]] < 0, 
     Re[$CellContext`\[Alpha]] > 0, 
     Re[$CellContext`k + $CellContext`\[Alpha]] > 0, Re[$CellContext`\[Beta]] > 
     0, Re[-$CellContext`k + $CellContext`n + $CellContext`\[Beta]] > 0], 
    SelectWithContents -> True, Selectable -> False]},
  "ConditionalExpression"]], "Output",
 CellChangeTimes->{{3.747410353916749*^9, 3.7474103749933662`*^9}, 
   3.747410649121051*^9, 3.747417992918096*^9, 3.747418131654636*^9, 
   3.747418481342277*^9, 3.74741917990317*^9, 3.779855806685924*^9, 
   3.816961712632717*^9, 3.989479098200428*^9},
 CellLabel->"Out[17]=",ExpressionUUID->"51bf1da2-8a10-47c7-ae15-2ccc32ddb6d3"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Interesting to look at the expanded formulation", "Text",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellChangeTimes->{{3.747459959250628*^9, 
  3.747459995238112*^9}},ExpressionUUID->"323fbec2-6f2b-48bb-937e-\
3e0d46805d51"],

Cell[BoxData[
 RowBox[{
  RowBox[{"PosteriorP", "[", " ", 
   RowBox[{
   "\[Theta]_", ",", " ", "\[Alpha]_", ",", "\[Beta]_", ",", " ", "k_", ",", 
    " ", "n_"}], "]"}], " ", ":=", " ", 
  FractionBox[
   RowBox[{
    SuperscriptBox["\[Theta]", "k"], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"1", "-", "\[Theta]"}], ")"}], 
     RowBox[{"n", "-", "k"}]], " ", 
    FractionBox[
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"1", "-", "x"}], ")"}], 
       RowBox[{
        RowBox[{"-", "1"}], "+", "\[Beta]"}]], " ", 
      SuperscriptBox["x", 
       RowBox[{
        RowBox[{"-", "1"}], "+", "\[Alpha]"}]]}], 
     RowBox[{
      SubsuperscriptBox["\[Integral]", "0", "1"], 
      RowBox[{
       SuperscriptBox["x", 
        RowBox[{"\[Alpha]", "-", "1"}]], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"1", "-", "x"}], ")"}], 
        RowBox[{"\[Beta]", "-", "1"}]], 
       RowBox[{"\[DifferentialD]", "x"}]}]}]]}], 
   RowBox[{
    SubsuperscriptBox["\[Integral]", "0", "1"], 
    RowBox[{
     SuperscriptBox["\[Theta]", "k"], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"1", "-", "\[Theta]"}], ")"}], 
      RowBox[{"n", "-", "k"}]], " ", 
     FractionBox[
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"1", "-", "x"}], ")"}], 
        RowBox[{
         RowBox[{"-", "1"}], "+", "\[Beta]"}]], " ", 
       SuperscriptBox["x", 
        RowBox[{
         RowBox[{"-", "1"}], "+", "\[Alpha]"}]]}], 
      RowBox[{
       SubsuperscriptBox["\[Integral]", "0", "1"], 
       RowBox[{
        SuperscriptBox["x", 
         RowBox[{"\[Alpha]", "-", "1"}]], 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"1", "-", "x"}], ")"}], 
         RowBox[{"\[Beta]", "-", "1"}]], 
        RowBox[{"\[DifferentialD]", "x"}]}]}]], " ", 
     RowBox[{"\[DifferentialD]", "\[Theta]"}]}]}]]}]], "Input",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellChangeTimes->{{3.747459841759337*^9, 3.747459920777499*^9}, 
   3.747459995239356*^9},ExpressionUUID->"7aa8050c-ece2-4859-910c-\
252a4e9750c0"]
}, Closed]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Simulate the experiment, inject new evidence", "Section",
 CellChangeTimes->{{3.7474029522650013`*^9, 3.747402981748098*^9}, {
  3.747411888853592*^9, 
  3.7474118915245247`*^9}},ExpressionUUID->"fef9346a-550a-47b2-9502-\
324c53b0ec22"],

Cell["\<\
Then we make a random generator to simulate the experiment and we will make \
the animation of the change in our belief of the fairness\
\>", "Text",
 CellChangeTimes->{{3.7472761382089033`*^9, 3.74727619110338*^9}, {
  3.747417384323676*^9, 3.747417394414228*^9}, {3.747419224571315*^9, 
  3.747419228611309*^9}},ExpressionUUID->"cafcf605-55d8-460e-9005-\
204597136657"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Flip", "[", "fairness_", "]"}], " ", ":=", " ", 
  RowBox[{"If", " ", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"RandomReal", "[", "]"}], " ", "<", " ", "fairness"}], ",", 
    " ", "\"\<Head\>\"", ",", " ", "\"\<Tail\>\""}], "]"}]}]], "Input",
 CellChangeTimes->{{3.747410971059204*^9, 3.747411108126009*^9}, {
  3.747411211091881*^9, 3.747411236165333*^9}},
 CellLabel->"In[18]:=",ExpressionUUID->"4704de7c-f0ee-4ab4-b66d-859242b53927"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SampleFlip", "[", 
   RowBox[{"N_", ",", " ", "fairness_"}], "]"}], " ", ":=", " ", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"samples", "=", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Flip", "[", "fairness", "]"}], ",", " ", "N"}], "]"}]}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Count", "[", 
       RowBox[{"samples", ",", "\"\<Head\>\""}], "]"}], ",", " ", 
      RowBox[{"Count", "[", 
       RowBox[{"samples", ",", "\"\<Tail\>\""}], "]"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.747413218442636*^9, 3.747413362697578*^9}, 
   3.747413397732271*^9, {3.747413435748023*^9, 3.747413459062479*^9}, {
   3.747413504313931*^9, 3.747413506013624*^9}},
 CellLabel->"In[19]:=",ExpressionUUID->"4fd7dfdc-b3ba-462e-bcd4-9b80be5fc598"],

Cell["\<\
At first we believe in a fair coin, but not really sure, then choose the \
values of \[Alpha] and \[Beta] low and equals. \
\>", "Text",
 CellChangeTimes->{{3.747411893861146*^9, 3.747411923585689*^9}, {
   3.747411986189237*^9, 3.747412005350194*^9}, {3.747416680237678*^9, 
   3.74741675349676*^9}, 3.747416807332954*^9, {3.747417443729486*^9, 
   3.7474174925003157`*^9}},ExpressionUUID->"649c7da8-0033-4a9f-af7c-\
ba63281b8c62"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   SubscriptBox["\[Alpha]", "e"], "=", 
   RowBox[{
    SubscriptBox["\[Beta]", "e"], "=", "5"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"PriorP", "[", 
