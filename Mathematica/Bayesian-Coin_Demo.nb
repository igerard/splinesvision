Cell[BoxData[
 TemplateBox[{
   FractionBox[
    RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
         RowBox[{"1", "-", "x"}], ")"}], 
       RowBox[{
         RowBox[{"-", "1"}], "+", "\[Beta]"}]], " ", 
      SuperscriptBox["x", 
