Cell["Animate Speed and acceleration on the surface", "Subsection",
 CellChangeTimes->{{3.989477913897151*^9, 
  3.9894779633609037`*^9}},ExpressionUUID->"cd0f5be3-5d96-4f93-936f-\
7c9f651c96e1"],

Cell["\<\
SSppU = Derivative[1,0][SSp];
SSppV = Derivative[0,1][SSp];
TriedreSurf[s_Sp,spU_,spV_,{u_,v_}] :=
  Block[{p = s[u,v],
          vU = spU[u,v],
          vV = spV[u,v],
          n = vU ~Cross~ vV},
      Graphics3D[{AbsoluteThickness[2],
       RGBColor[1,0,0],
       Line[{p,p+vU}],
       RGBColor[0,1,0],
       Line[{p,p+vV}],
       RGBColor[0,0,1],
       Line[{p,p+n}]}]]
            
TriedreSurf[s_Sp,pars:{{_,_}..}] :=
  Block[{spU = Derivative[1,0][s],
          spV = Derivative[0,1][s]},
      Map[TriedreSurf[s,spU,spV,#]&,pars]]
            
Animate[Show[{surf,TriedreSurf[SSp,SSppU, SSppV, {u,v}]}, PlotRange -> {{-2, \
7}, {-2, 7}, {-2, 7}}], {u,0,3}, {v, 0, 2},
        AnimationRunning -> False]\
\>", "Input",
 CellChangeTimes->{
  3.988827350846471*^9, {3.9894778641343613`*^9, 3.9894779064412603`*^9}},
 CellLabel->"In[48]:=",ExpressionUUID->"fd704646-808c-4807-891a-126de9f84a91"]
}, Open  ]]
}, Open  ]],

