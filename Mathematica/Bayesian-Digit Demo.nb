Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "We", " ", "just", " ", "use", " ", "one", " ", "of", " ", "the", " ", 
     "more", " ", "obvious", " ", "way", " ", "to", " ", "define", " ", "a", " ",
      "distribution", " ", "probability", " ", "density", " ", "function"}], ",",
     " ", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
     "Mathematica", " ", "contains", " ", "a", " ", "lot", " ", "of", " ", 
      "different", " ", "built"}], "-", 
     RowBox[{"in", " ", "probability", " ", "density", " ", "function"}]}], ",",
     "\[IndentingNewLine]", 
    RowBox[{
