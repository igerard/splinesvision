Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Read", " ", "the", " ", "file", " ", "which", " ", "contains", " ", "the",
     " ", "label", " ", "of", " ", "the", " ", "digits", " ", "\[IndentingNewLine]",
     "You", " ", "need", " ", "the", " ", "data", " ", "file", " ", "at", " ",
     "the", " ", "same", " ", "level", " ", "as", " ", "the", " ", "notebook",
     " ", "to", " ", "get", " ", "it", " ", "working"}], 
   "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"labelsInputFile", " ", "=", " ", 
    RowBox[{"OpenRead", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"NotebookDirectory", "[", "]"}], 
       "<>", "\"\<DigitSamples/train-labels.idx1-ubyte\>\""}], ",", " ", 
      RowBox[{"BinaryFormat", "\[Rule]", "True"}]}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{"magicNumber", " ", "=", " ", 
    RowBox[{"BinaryRead", "[", 
     RowBox[{"labelsInputFile", ",", "\"\<Integer32\>\"", ",", " ", 
      RowBox[{"ByteOrdering", "\[Rule]", "1"}]}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{"nbLabels", " ", "=", " ", 
    RowBox[{"BinaryRead", "[", 
     RowBox[{"labelsInputFile", ",", "\"\<Integer32\>\"", ",", " ", 
      RowBox[{"ByteOrdering", "\[Rule]", "1"}]}], "]"}]}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"The", " ", "label", " ", "table", " ", "itself"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"labels", " ", "=", " ", 
     RowBox[{"ReadList", "[", 
      RowBox[{"labelsInputFile", ",", "\"\<Byte\>\""}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Close", "[", "labelsInputFile", "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"Give", " ", "a", " ", "map", " ", "values"}], " ", "\[Rule]", 
      " ", 
      RowBox[{
       RowBox[{
        RowBox[{
        "List", " ", "of", " ", "positions", " ", "in", " ", "the", " ", 
         "list"}], "..."}], " ", "give", " ", "us", " ", "all", " ", "the", " ",
        "position", " ", "of", " ", "label", " ", "0"}]}], ",", "1", ",", "2",
      ",", "...", ",", "9"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"GPI", " ", "=", " ", 
    RowBox[{"PositionIndex", "[", "labels", "]"}]}], "\[IndentingNewLine]", 
   RowBox[{"labels", " ", "//", " ", "Dimensions"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "Read", " ", "the", " ", "file", " ", "which", " ", "contains", " ", 
      "the", " ", "images", " ", "data", " ", "of", " ", "the", " ", 
      "digits"}], ",", " ", 
     RowBox[{"in", " ", "bytes"}], ",", " ", 
     RowBox[{"0", " ", "\[Rule]", " ", 
      RowBox[{"255", " ", ":", " ", 
       RowBox[{"black", " ", "to", " ", "white"}]}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"imagesInputFile", " ", "=", " ", 
    RowBox[{"OpenRead", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"NotebookDirectory", "[", "]"}], 
       "<>", "\"\<DigitSamples/train-images.idx3-ubyte\>\""}], ",", " ", 
      RowBox[{"BinaryFormat", "\[Rule]", "True"}]}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{"magicNumber", " ", "=", " ", 
    RowBox[{"BinaryRead", "[", 
     RowBox[{"imagesInputFile", ",", "\"\<Integer32\>\"", ",", " ", 
      RowBox[{"ByteOrdering", "\[Rule]", "1"}]}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{"nbImages", " ", "=", " ", 
    RowBox[{"BinaryRead", "[", 
     RowBox[{"imagesInputFile", ",", "\"\<Integer32\>\"", ",", " ", 
      RowBox[{"ByteOrdering", "\[Rule]", "1"}]}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{"nbRows", " ", "=", " ", 
    RowBox[{"BinaryRead", "[", 
     RowBox[{"imagesInputFile", ",", "\"\<Integer32\>\"", ",", " ", 
      RowBox[{"ByteOrdering", "\[Rule]", "1"}]}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{"nbColums", " ", "=", " ", 
    RowBox[{"BinaryRead", "[", 
     RowBox[{"imagesInputFile", ",", "\"\<Integer32\>\"", ",", " ", 
      RowBox[{"ByteOrdering", "\[Rule]", "1"}]}], "]"}]}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"theimages", " ", "itself"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"a", " ", "list", " ", "of", " ", "matrix"}], " ", "..."}], " ",
       "dimension", " ", "nbImages", " ", "x", " ", "nbRows", " ", "x", " ", 
      "nbColums"}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"DID", " ", "=", " ", 
     RowBox[{"ReadList", "[", 
      RowBox[{"imagesInputFile", ",", 
       RowBox[{"Array", "[", 
        RowBox[{
         RowBox[{"\"\<Byte\>\"", "&"}], ",", 
         RowBox[{"{", 
          RowBox[{"nbRows", ",", "nbColums"}], "}"}]}], "]"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Close", "[", "imagesInputFile", "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"DID", " ", "//", " ", "Dimensions"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "function", " ", "to", " ", "retrieve", " ", "the", " ", "data", " ", 
     "of", " ", "the", " ", "given", " ", "label"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"LabelData", "[", "label_", "]"}], " ", ":=", " ", 
    RowBox[{"DID", "[", 
     RowBox[{"[", 
      RowBox[{"GPI", "[", "label", "]"}], "]"}], "]"}]}]}]}]], "Input",
