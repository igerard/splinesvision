065b6f6bb5a2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"PosteriorP", "[", " ", 
   RowBox[{
   "\[Theta]_", ",", " ", "\[Alpha]_", ",", "\[Beta]_", ",", " ", "k_", ",", 
    " ", "n_"}], "]"}], " ", ":=", " ", 
  FractionBox[
   RowBox[{
    RowBox[{"LikelihoodP", "[", 
     RowBox[{"n", ",", "k", ",", "\[Theta]"}], "]"}], " ", 
    RowBox[{"PriorP", "[", 
     RowBox[{"\[Theta]", ",", " ", "\[Alpha]", ",", " ", "\[Beta]"}], "]"}]}], 
   RowBox[{"EvidenceP", "[", 
    RowBox[{"n", ",", " ", "k", ",", "  ", "\[Alpha]", ",", "\[Beta]"}], 
    "]"}]]}]], "Input",
 CellChangeTimes->{{3.747403045924872*^9, 3.747403050910575*^9}, {
