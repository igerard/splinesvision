Notebook[{

Cell[CellGroupData[{
Cell["Baye\[CloseCurlyQuote]s Theorem - flipping a coin and fairness", \
"Chapter",
 CellChangeTimes->{{3.744158935433773*^9, 3.744158993813163*^9}, 
   3.7473944826579723`*^9},ExpressionUUID->"b460b876-0df2-4cc0-b159-\
60de5dbffa81"],

Cell["\<\
How an evidence change our belief in the fairness of the coin\
\>", "Text",
 CellChangeTimes->{{3.747395127104776*^9, 3.747395135234705*^9}, {
  3.747401251545329*^9, 
  3.74740127106247*^9}},ExpressionUUID->"baf33d7f-6082-4641-9bcd-\
25779b557057"],

Cell["General Baye's theorem formulation :", "Text",
 CellChangeTimes->{{3.747401276456725*^9, 3.747401297234861*^9}, 
   3.747412173652279*^9},ExpressionUUID->"f1adc2ba-da9b-407a-b9fe-\
be8eaedd25e6"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"PosteriorP", "(", 
    RowBox[{"\[Theta]", ",", "D"}], ")"}], "=", 
   FractionBox[
    RowBox[{
     RowBox[{"PriorP", "(", "\[Theta]", ")"}], " ", 
     RowBox[{"LikelihoodP", "[", 
      RowBox[{"D", ",", "\[Theta]"}], "]"}]}], 
    RowBox[{"EvidenceP", "(", "D", ")"}]]}], TraditionalForm]], "Input",
 CellChangeTimes->{{3.7474013100151987`*^9, 3.747401345986356*^9}, {
  3.74740137828701*^9, 
  3.7474013970977077`*^9}},ExpressionUUID->"dce9c025-ad35-47ea-a390-\
380acf465802"],

Cell["\<\
We detail the construction of the different piece of the Baye\
\[CloseCurlyQuote]s theorem in case of our coin experiment with the Bernoulli \
distribution\
\>", "Text",
 CellChangeTimes->{{3.747401407896018*^9, 
  3.747401462934125*^9}},ExpressionUUID->"a4398344-2cb2-489f-8f11-\
ff1315d042ef"],

Cell[CellGroupData[{

Cell["First the Beta function", "Section",
 CellChangeTimes->{{3.747401577703912*^9, 3.7474016056006308`*^9}, {
  3.7474016961006613`*^9, 
  3.7474016984020987`*^9}},ExpressionUUID->"677f8585-87d6-4d50-b1e3-\
c735af9af5e0"],

Cell["Used in the definition of the Prior belief function", "Text",
 CellChangeTimes->{{3.7474017001452837`*^9, 
  3.747401724361053*^9}},ExpressionUUID->"9a383cef-eaf9-41af-b19f-\
ffa124bf5e38"],

Cell[TextData[{
 "(",
 StyleBox["BetaS",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " because Mathematica has already the Beta function defined)"
}], "Text",
 CellChangeTimes->{{3.7474122050586452`*^9, 3.747412224406681*^9}},
 FontSize->18,ExpressionUUID->"2ae45aa3-80f2-476e-8dd2-cea50ea503e8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"BetaS", "[", 
   RowBox[{"\[Alpha]_", ",", "\[Beta]_"}], "]"}], " ", "=", " ", 
  RowBox[{
   SubsuperscriptBox["\[Integral]", "0", "1"], 
   RowBox[{
    SuperscriptBox["x", 
     RowBox[{"\[Alpha]", "-", "1"}]], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"1", "-", "x"}], ")"}], 
     RowBox[{"\[Beta]", "-", "1"}]], 
    RowBox[{"\[DifferentialD]", "x"}]}]}]}]], "Input",
 CellChangeTimes->{{3.744470359602161*^9, 3.7444704781630697`*^9}, {
   3.747245119094475*^9, 3.747245131797353*^9}, {3.747245171613698*^9, 
   3.74724517968254*^9}, {3.747245253616353*^9, 3.7472452651629677`*^9}, {
   3.747245315824698*^9, 3.747245318577318*^9}, {3.747245392254888*^9, 
   3.7472454054720592`*^9}, 3.747410517540557*^9, 3.7474105699250526`*^9, {
   3.747410677525935*^9, 3.747410681133602*^9}},
 CellLabel->"In[7]:=",ExpressionUUID->"4403774a-9527-4820-a84b-fdbfde181998"],

Cell[BoxData[
 TemplateBox[{
   FractionBox[
    RowBox[{
      RowBox[{"Gamma", "[", "\[Alpha]", "]"}], " ", 
      RowBox[{"Gamma", "[", "\[Beta]", "]"}]}], 
    RowBox[{"Gamma", "[", 
      RowBox[{"\[Alpha]", "+", "\[Beta]"}], "]"}]], 
   RowBox[{
     RowBox[{
       RowBox[{"Re", "[", "\[Alpha]", "]"}], ">", "0"}], "&&", 
     RowBox[{
       RowBox[{"Re", "[", "\[Beta]", "]"}], ">", "0"}]}]},
  "ConditionalExpression"]], "Output",
 CellChangeTimes->{3.747410574099873*^9, 3.747417170325225*^9, 
  3.747417919142922*^9, 3.747418360673911*^9, 3.747418422606347*^9, 
  3.7474189218929358`*^9, 3.779855585700842*^9, 3.816961584081197*^9, 
  3.989479064208838*^9},
 CellLabel->"Out[7]=",ExpressionUUID->"827b7051-cb0e-488b-b18a-5a13b3a67018"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 FractionBox["1", 
  RowBox[{"BetaS", "[", 
   RowBox[{"\[Alpha]", ",", " ", "\[Beta]"}], "]"}]]], "Input",
