Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"PriorP", "[", 
  RowBox[{"x", ",", " ", "\[Alpha]", ",", " ", "\[Beta]"}], "]"}]], "Input",
 CellChangeTimes->{{3.7474178222201*^9, 3.747417830627163*^9}, {
