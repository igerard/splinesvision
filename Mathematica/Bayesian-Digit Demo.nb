         "epsilon"}], "]"}], "]"}], "&"}], ",", " ", 
     RowBox[{"Dimensions", "[", "vm", "]"}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.745870600402165*^9, 3.74587067903785*^9}, {
