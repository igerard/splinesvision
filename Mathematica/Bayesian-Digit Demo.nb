8ea23958c0cb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Compute", " ", "the", " ", "matrix", " ", "of", " ", "the", " ", "P", 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["x", "i"], "|", "Ck"}], ")"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"logMatrixCompMap", "[", 
    RowBox[{"fm_", ",", " ", "vm_"}], "]"}], " ", ":=", " ", 
   RowBox[{"ParallelArray", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Log", "[", 
       RowBox[{"Max", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"fm", "[", 
           RowBox[{"[", 
            RowBox[{"#1", ",", "#2"}], "]"}], "]"}], "[", 
          RowBox[{"vm", "[", 
           RowBox[{"[", 
