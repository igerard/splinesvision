Cell[CellGroupData[{

Cell["The likelihood of the evidence", "Section",
 CellChangeTimes->{{3.747395111217308*^9, 
  3.747395122122088*^9}},ExpressionUUID->"1f1d5290-d837-4972-81ae-\
a25ad6da8d17"],

Cell[TextData[{
 "The event ",
 StyleBox["n",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[" ",
  FontSlant->"Italic"],
 "flips with ",
 StyleBox["k",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[" ",
  FontSlant->"Italic"],
 "heads will be formalized as the couple ",
 StyleBox["n,k",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox["\n",
  FontSlant->"Italic"],
 "Then we want to define the probability function of this event when the \
fairness of the coin is known as \[Theta], the likelihood probability \
function is:"
}], "Text",
 CellChangeTimes->{{3.744351918312491*^9, 3.7443519251108027`*^9}, {
  3.744352015072097*^9, 3.7443521493487263`*^9}, {3.744352273741962*^9, 
  3.744352396931242*^9}, {3.744352607692704*^9, 3.744352642917616*^9}, {
  3.744352806593258*^9, 3.7443528132331123`*^9}, {3.74724148856597*^9, 
  3.7472415555059566`*^9}, {3.747401953449568*^9, 3.747401996611821*^9}, {
  3.747410137179003*^9, 
  3.747410144478416*^9}},ExpressionUUID->"350296c0-1c8a-4ad9-8bde-\
7cd4abe9589d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"LikelihoodP", "[", 
   RowBox[{"n_", ",", " ", "k_", ",", " ", "\[Theta]_"}], "]"}], " ", ":=", 
  " ", 
  RowBox[{
   SuperscriptBox["\[Theta]", "k"], 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"1", "-", "\[Theta]"}], ")"}], 
    RowBox[{"n", "-", "k"}]]}]}]], "Input",
 CellChangeTimes->{{3.7443519047067013`*^9, 3.744351905777171*^9}, {
  3.7443525752704763`*^9, 3.744352598676487*^9}, {3.7443527195946608`*^9, 
  3.7443527608658257`*^9}, {3.744352793029567*^9, 3.7443527948746862`*^9}, {
  3.74740216161382*^9, 3.7474021660315437`*^9}, {3.747402256153062*^9, 
  3.7474022689038877`*^9}},
 CellLabel->"In[12]:=",ExpressionUUID->"a7b2da44-4348-4594-b8c3-3a95575433ec"]
}, Open  ]],

Cell[CellGroupData[{

Cell["The probability of the Evidence", "Section",
 CellChangeTimes->{{3.7474029210133657`*^9, 
  3.747402933676197*^9}},ExpressionUUID->"1cf52f6d-2783-4647-8d28-\
ad2460e0e86a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"EvidenceP", "[", 
   RowBox[{"n_", ",", " ", "k_", ",", "  ", "\[Alpha]_", ",", "\[Beta]_"}], 
   "]"}], " ", ":=", " ", 
  RowBox[{
   SubsuperscriptBox["\[Integral]", "0", "1"], 
   RowBox[{
    RowBox[{"LikelihoodP", "[", 
     RowBox[{"n", ",", "k", ",", "\[Theta]"}], "]"}], " ", 
    RowBox[{"PriorP", "[", 
     RowBox[{"\[Theta]", ",", "\[Alpha]", ",", "\[Beta]"}], "]"}], " ", 
    RowBox[{"\[DifferentialD]", "\[Theta]"}]}]}]}]], "Input",
 CellChangeTimes->{{3.7474022029079437`*^9, 3.747402321215515*^9}, 
   3.747402823483396*^9, {3.7474030779776373`*^9, 3.747403081180995*^9}, {
   3.747410189600465*^9, 3.747410206932736*^9}},
 CellLabel->"In[13]:=",ExpressionUUID->"8ef3f89e-c208-4f7c-bc50-a402f3216348"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"EvidenceP", "[", 
  RowBox[{"n", ",", " ", "k", ",", "  ", "\[Alpha]", ",", " ", "\[Beta]"}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.7474187599178658`*^9, 3.747418763669745*^9}, {
  3.747418802386737*^9, 3.7474188068444242`*^9}},
 CellLabel->"In[14]:=",ExpressionUUID->"b5d18657-54f7-4857-8f6a-f902111872c0"],

Cell[BoxData[
 TemplateBox[{
   FractionBox[
    RowBox[{
      RowBox[{"Gamma", "[", 
        RowBox[{"k", "+", "\[Alpha]"}], "]"}], " ", 
      RowBox[{"Gamma", "[", 
        RowBox[{
          RowBox[{"-", "k"}], "+", "n", "+", "\[Beta]"}], "]"}], " ", 
      RowBox[{"Gamma", "[", 
        RowBox[{"\[Alpha]", "+", "\[Beta]"}], "]"}]}], 
    RowBox[{
      RowBox[{"Gamma", "[", "\[Alpha]", "]"}], " ", 
      RowBox[{"Gamma", "[", "\[Beta]", "]"}], " ", 
      RowBox[{"Gamma", "[", 
        RowBox[{"n", "+", "\[Alpha]", "+", "\[Beta]"}], "]"}]}]], 
   RowBox[{
     RowBox[{
       RowBox[{"Re", "[", "\[Alpha]", "]"}], ">", "0"}], "&&", 
     RowBox[{
       RowBox[{"Re", "[", "\[Beta]", "]"}], ">", "0"}], "&&", 
     RowBox[{
       RowBox[{"Re", "[", "k", "]"}], "<", 
       RowBox[{"Re", "[", 
         RowBox[{"n", "+", "\[Beta]"}], "]"}]}], "&&", 
     RowBox[{
       RowBox[{"Re", "[", 
         RowBox[{"k", "+", "\[Alpha]"}], "]"}], ">", "0"}]}]},
  "ConditionalExpression"]], "Output",
 CellChangeTimes->{3.747418764824348*^9, 3.747418811356444*^9, 
  3.747419048667033*^9, 3.7798557043112307`*^9, 3.8169616720436993`*^9, 
  3.989479091416011*^9},
 CellLabel->"Out[14]=",ExpressionUUID->"9a38243a-4432-4774-a757-9e8958b6d850"]
}, Open  ]]
}, Open  ]],

