Cell[TextData[{
 "Classifier for hand made digit, giving some digit recognition algorithm\n\n\
The data set are available here with some interesting comments : ",
 StyleBox["http://yann.lecun.com/exdb/mnist",
  FontSize->24,
  FontWeight->"Bold",
  FontSlant->"Italic",
  FontColor->RGBColor[0, 0, 1]]
}], "Text",
 CellChangeTimes->{{3.747577526551984*^9, 3.7475775336230993`*^9}, {
   3.747631489209278*^9, 3.7476315398646584`*^9}, {3.7476315859612217`*^9, 
   3.747631594147461*^9}, 
   3.747631635317442*^9},ExpressionUUID->"bb0334a7-ad30-4c7e-9efa-\
8f3bb0b2823f"],

Cell["\<\
Recognizing digit with a Bayes\[CloseCurlyQuote] Classifier request to \
compute the probability of a pixel value, of the image to analyse, to get its \
value in a given class
For that we need to learn this information from a data set, the data set will \
give us the knowledge 
We need to extract from the data set the data relative to a class, here a \
label representing the digit value.
For each class of label, we compute the density/distribution probability \
function \
\>", "Text",
 CellChangeTimes->{{3.747646034572035*^9, 3.747646118340728*^9}, {
  3.747646274081407*^9, 3.74764635098635*^9}, {3.747886760896495*^9, 
  3.747886761424287*^9}, {3.74788711910474*^9, 3.747887119487483*^9}, {
  3.748331519752829*^9, 
  3.748331526469833*^9}},ExpressionUUID->"c76a6521-120c-4548-adab-\
83506749752b"],

Cell[TextData[{
 "Notes : \n\n1/  This pattern In Mathematica\n\t",
 StyleBox["f[x_] := f[x] =",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " ",
 StyleBox["an Expression with x as parameter\n",
  FontWeight->"Bold",
  FontSlant->"Italic",
  FontColor->RGBColor[1, 0, 1]],
 StyleBox["allow to memorize the computed value of f(x) ... I use it \
intensively in the demo, unless we have to build a lot of storage variable... \
\n\n2/ Take care to the way Mathematica evaluate expression, delayed or not, \
subtle...\n\n3/ I generate a lot of graphics, images, and the notebook can \
become slow, even if the computations stay fast",
  FontColor->GrayLevel[0]]
}], "Text",
 CellChangeTimes->{{3.747638655151884*^9, 3.747638720029991*^9}, {
  3.747638755234085*^9, 3.747638844383791*^9}, {3.747646376120632*^9, 
  3.747646419994009*^9}, {3.747823896757186*^9, 3.747823945465551*^9}, {
  3.747888498471972*^9, 
  3.7478885410751266`*^9}},ExpressionUUID->"32a9d494-69fe-429c-9fc3-\
0362fe4db65d"],

